# Copy to .env and fill in. Never commit .env.

# Required: Django secret key (any long random string).
SECRET_KEY=
# Comma-separated host names the app answers to.
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 1 for local development only (enables the insecure dev key and debug pages).
# DEBUG=1
# Postgres URL; docker compose sets this for the bundled db service.
# DATABASE_URL=postgres://asb:asb@localhost:5432/asb
{% if has_connector %}

# ERP connection ({{ connector }} connector).
ASB_ERP_URL=
ASB_ERP_API_KEY=
ASB_ERP_API_SECRET=
{% endif %}
