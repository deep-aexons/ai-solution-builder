"""GET /api/meta/: entities, workflows and what the current user may do."""

from rest_framework.permissions import IsAuthenticated
from rest_framework.response import Response
from rest_framework.views import APIView

from workflow.definitions import ENTITIES, REPORT_ACCESS, REPORTS, WORKFLOWS
from workflow.engine import available_actions, user_perms, user_roles


def build_meta(user):
    entities = []
    for name, spec in ENTITIES.items():
        item = {"name": name, "label": spec["label"]}
        if spec["numbering"]:
            item["numbering"] = spec["numbering"]
        item["fields"] = [dict(f) for f in spec["fields"]]
        item["child_of"] = spec["child_of"]
        entities.append(item)
    workflows = [
        {"entity": entity, **{k: v for k, v in wf.items()}}
        for entity, wf in WORKFLOWS.items()
    ]
    roles = sorted(user_roles(user))
    reports = [
        r for r in REPORTS if any(r in REPORT_ACCESS.get(role, []) for role in roles)
    ]
    return {
        "entities": entities,
        "workflows": workflows,
        "reports": reports,
        "user": {
            "username": user.get_username(),
            "roles": roles,
            "permissions": {name: user_perms(user, name) for name in ENTITIES},
            "actions": {name: available_actions(user, name) for name in ENTITIES},
        },
    }


class MetaView(APIView):
    permission_classes = [IsAuthenticated]

    def get(self, request):
        return Response(build_meta(request.user))
