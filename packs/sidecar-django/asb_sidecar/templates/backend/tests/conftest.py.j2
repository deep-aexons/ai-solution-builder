class FakeConnector:
    """In-memory ERP implementing asb.connector.Connector; seed it per test."""

    def __init__(self):
        self.records = {}
        self.created = []

    def seed(self, kind, id, record):
        self.records.setdefault(kind, {})[id] = {"name": id, **record}

    def inspect(self):
        return {"kinds": sorted(self.records)}

    def get(self, kind, id):
        from asb.connector import NotFound

        try:
            return dict(self.records[kind][id])
        except KeyError:
            raise NotFound(f"{kind} {id} not found") from None

    def list(self, kind, filters=None, fields=None, limit=50):
        rows = []
        for record in self.records.get(kind, {}).values():
            if all(record.get(k) == v for k, v in (filters or {}).items()):
                rows.append({k: record.get(k) for k in fields} if fields else dict(record))
        return rows[:limit]

    def create_draft(self, kind, data):
        draft_id = f"DRAFT-{len(self.created) + 1}"
        self.seed(kind, draft_id, {**data, "_state": "draft"})
        self.created.append((kind, draft_id))
        return dict(self.records[kind][draft_id])


