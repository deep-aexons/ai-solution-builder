class Samples:
    def __init__(self):
        self.n = 0

    def complete(self, entity):
        return SAMPLES[entity]["complete"]

    def payload(self, entity):
        spec = SAMPLES[entity]
        if not spec["complete"]:
            pytest.skip(f"no valid sample for {entity}: {spec['reason']}")
        self.n += 1
        data = copy.deepcopy(spec["payload"])
        for attr in spec["unique"]:
            data[attr] = f"{data[attr]}{self.n}" if isinstance(data[attr], str) else data[attr] + self.n
        return data

    def make(self, entity, state=None, owner=None):
        """Create a record through the ORM; returns (object, request payload)."""
        from django.apps import apps

        payload = self.payload(entity)
        info = ENTITIES[entity]
        tables = {t["name"]: t["of"] for t in info["tables"]}
        values = {k: v for k, v in payload.items() if k not in tables}
        if state is not None and entity in WORKFLOWS:
            values["state"] = state
        obj = apps.get_model("entities", info["model"]).objects.create(created_by=owner, **values)
        for name, child in tables.items():
            model = apps.get_model("entities", ENTITIES[child]["model"])
            for row in payload.get(name, []):
                model.objects.create(
                    parent=obj, **{k: v for k, v in row.items() if not isinstance(v, list)}
                )
        return obj, payload

    def patch_body(self, entity, payload):
        attr = SAMPLES[entity]["patch"]
        if attr is None:
            pytest.skip(f"{entity} has no scalar field to change")
        return {attr: payload[attr]}


@pytest.fixture
def samples():
    return Samples()
