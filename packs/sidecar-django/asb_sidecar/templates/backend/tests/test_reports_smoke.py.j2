"""Every report runs on an empty database for a role with access and returns rows."""
{% if report_cases %}

import pytest

pytestmark = pytest.mark.report

REPORTS = {{ reports_lit }}
REPORT_ACCESS = {{ report_access_lit }}


@pytest.mark.parametrize("report", REPORTS)
def test_report_runs(report, api, rules_noop):
    roles = [role for role, names in REPORT_ACCESS.items() if report in names]
    if not roles:
        pytest.skip(f"no-role-has-access: no role may run {report}")
    resp = api(roles[0]).get(f"/api/reports/{report}/")
    assert resp.status_code == 200, resp.content
    body = resp.json()
    assert body["name"] == report
    assert isinstance(body["rows"], list)
{% endif %}
