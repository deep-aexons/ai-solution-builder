# GENERATED by asb — do not edit; regenerate from solution.yaml
# Stage 1: build the React frontend.
FROM node:22-alpine AS frontend
WORKDIR /build/frontend
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# Stage 2: Django/gunicorn backend serving the built frontend through WhiteNoise.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app/backend
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./
COPY --from=frontend /build/frontend/dist /app/frontend/dist
RUN SECRET_KEY=build-only python manage.py collectstatic --noinput \
    && useradd --system --uid 10001 asb \
    && mkdir -p media \
    && chown asb media
USER asb
EXPOSE 8000
CMD ["sh", "-c", "python manage.py migrate && python manage.py asb_sync_roles && gunicorn config.wsgi -b 0.0.0.0:8000"]
